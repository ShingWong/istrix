# iStrix environment variables
# Copy to .env and fill in your values

# PostgreSQL (required for backend)
ISTRIX_DB_URL=postgresql+asyncpg://istrix:YOUR_PASSWORD@localhost/istrix
ISTRIX_DB_URL_SYNC=postgresql+psycopg2://istrix:YOUR_PASSWORD@localhost/istrix

# AI provider (optional, for AI features)
# STRIX_AI_PROVIDER=openrouter
# STRIX_AI_API_KEY=sk-or-v1-...
# STRIX_AI_MODEL=deepseek/deepseek-v4-pro

# NVD API key (optional, for faster CVE enrichment)
# NVD_API_KEY=your-key
